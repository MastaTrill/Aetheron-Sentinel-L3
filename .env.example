# Copy this file to .env.local and fill in your values

# RPC Endpoints
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Deployment Tag
DEPLOY_TAG=sentinel-l3-v1

# Private Keys (never commit real keys!)
OWNER_PRIVATE_KEY=0x...

# Deployment Addresses
OWNER_ADDRESS=0x...
AUDITOR_ADDRESS=0x...

# Contract Addresses (for patch/health scripts)
SENTINEL_CORE=0x...
SENTINEL_TOKEN=0x...
SENTINEL_STAKING=0x...
SENTINEL_REWARD_AGGREGATOR=0x...
SENTINEL_INSURANCE_PROTOCOL=0x...
SENTINEL_AMM=0x...
AETHERON_BRIDGE=0x...

# Optional API Keys
BASESCAN_API_KEY=your_basescan_key_here
ETHERSCAN_API_KEY=your_etherscan_key_here
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
