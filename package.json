{
  "name": "aetheron-sentinel-l3",
  "version": "1.0.0",
  "description": "Autonomous Sentinel L3 Node Environment",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "mocha": "node node_modules/hardhat/dist/src/cli.js test test/smoke.test.js test/AetheronBridge.test.js test/CircuitBreaker.test.js test/SentinelAMM.test.js test/SentinelCore.test.js test/SentinelCoreLoop.test.js test/SentinelGovernance.test.js test/SentinelHomomorphicEncryption.test.js test/SentinelInsuranceMarketplace.test.js test/SentinelInsuranceProtocol.test.js test/SentinelInterceptor.test.js test/SentinelLiquidityMining.test.js test/SentinelMonitor.test.js test/SentinelMultiSigVault.test.js test/SentinelOracleNetwork.test.js test/SentinelPredictiveThreatModel.test.js test/SentinelQuantumGuard.test.js test/SentinelQuantumKeyDistribution.test.js test/SentinelQuantumNeural.test.js test/SentinelReferralSystem.test.js test/SentinelRewardAggregator.test.js test/SentinelSecurityAuditor.test.js test/SentinelSecurityTokenization.test.js test/SentinelSocialRecovery.test.js test/SentinelStaking.test.js test/SentinelTimelock.test.js test/SentinelToken.test.js test/SentinelYieldMaximizer.test.js test/SentinelZKIdentity.test.js test/SentinelZKOracle.test.js",
    "test:gas": "npm run compile && node scripts/gas-analysis.js",
    "test:gas:core": "hardhat test test/SentinelCore.gas.test.js",
    "test:coverage": "node node_modules/hardhat/dist/src/cli.js coverage",
    "compile": "node scripts/compile-contracts.js",
    "verify:bytecode": "node scripts/verify-bytecode.js",
    "ci:build": "export NODE_OPTIONS=\"--max-old-space-size=$(node -e 'console.log(Math.floor(require(\"os\").totalmem()/1024/1024*0.8))') --gc_global\" && forge build --jobs 1",
    "ci:test:vault": "forge test --match-contract AetheronRetainerVault -vvvv",
    "deploy": "node node_modules/hardhat/dist/src/cli.js run scripts/deploy.js",
    "deploy:local": "hardhat run scripts/deploy.js --network direct_l3",
    "deploy:testnet": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:base-sepolia": "hardhat run scripts/deploy-release-core.cjs --network baseSepolia",
    "preflight:base-sepolia": "node scripts/mainnet-preflight.js",
    "deploy:mainnet": "node -e \"throw new Error('Direct mainnet deployment is disabled; use the protected Base mainnet workflow')\"",
    "deploy:polygon": "node node_modules/hardhat/dist/src/cli.js run scripts/deploy.js --network polygon",
    "deploy:base": "hardhat run scripts/deploy-release-core.cjs --network base",
    "deploy:arbitrum": "node -e \"throw new Error('Arbitrum production deployment is not part of the frozen release scope')\"",
    "setup:ownership": "node scripts/setup-ownership.js",
    "setup:verify-tooling": "node scripts/setup-verify-tooling.js",
    "deploy:verify": "npm run compile && node scripts/deployment-verification.js",
    "verify:testnet": "node node_modules/hardhat/dist/src/cli.js run scripts/verify.js --network sepolia",
    "verify:mainnet": "node node_modules/hardhat/dist/src/cli.js run scripts/verify.js --network mainnet",
    "verify:ownership": "node scripts/verify-ownership-mainnet.js",
    "lint": "eslint hardhat.config.js scripts/ test/ --config .eslintrc.json --max-warnings 20",
    "lint:fix": "eslint hardhat.config.js scripts/ test/ --config .eslintrc.json --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,md}\"",
    "format:check:release": "prettier --check config/release-core.json scripts/lib/release-core.cjs scripts/lib/github-api.cjs scripts/lib/github-environment.cjs scripts/lib/immutable-release.cjs scripts/lib/base-sepolia-rehearsal.cjs scripts/deploy-release-core.cjs scripts/verify-release-core.cjs scripts/validate-release-scope.cjs scripts/validate-github-environment.cjs scripts/validate-immutable-release.cjs scripts/validate-base-sepolia-rehearsal.cjs scripts/mainnet-preflight.js deploy/verify-mainnet.ts test/ReleaseDeploymentSafety.test.js test/SentinelInsuranceProtocol.test.js test/github-environment.test.cjs test/release-evidence.test.cjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:audit:toolchain": "npm audit --audit-level=high",
    "security:release-scope": "node scripts/validate-release-scope.cjs",
    "security:deployment-environment": "node scripts/validate-github-environment.cjs",
    "security:immutable-release": "node scripts/validate-immutable-release.cjs",
    "security:base-sepolia-rehearsal": "node scripts/validate-base-sepolia-rehearsal.cjs",
    "export:abis": "node scripts/export-abis.js",
    "export:all-abis": "node scripts/export-abis.js",
    "export:site-config": "node scripts/export-site-config.js",
    "update:subgraph": "node scripts/update-subgraph.js",
    "mainnet:preflight": "node scripts/mainnet-preflight.js",
    "mainnet:finalize": "node scripts/finalize-mainnet-release.js",
    "evidence:daily": "node scripts/launch-evidence-daily.js",
    "redeploy:coreloop": "node scripts/redeploy-coreloop.js",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:lint": "npm --prefix dashboard run lint",
    "dashboard:build": "npm --prefix dashboard run build",
    "dev": "next dev",
    "build:web": "next build",
    "start": "next start",
    "lint:web": "eslint src/ --config .eslintrc.json",
    "add-liquidity": "hardhat run scripts/add-liquidity.js",
    "update:site-contracts": "node scripts/update-site-contracts.js",
    "evidence:automate": "node scripts/automate-evidence.js",
    "codegen": "node -e \"throw new Error('codegen via sentinel-l3-v1.0/ is retired (#203); use root tooling')\"",
    "build": "node -e \"throw new Error('build via sentinel-l3-v1.0/ is retired (#203); use mainnet:build, dashboard:build, or build:web')\"",
    "mainnet:build": "forge build --profile default",
    "mainnet:test": "forge test -vvv",
    "mainnet:simulate": "DEPLOYMENT_MANIFEST_PATH=/tmp/sentinel-guardrails-simulation.json ALLOW_MANIFEST_OVERWRITE=true hardhat run scripts/deploy-release-core.cjs",
    "test:release": "npm run test:release:contracts && npm run test:release:policy",
    "test:release:contracts": "hardhat test test/ReleaseDeploymentSafety.test.js test/SentinelInsuranceProtocol.test.js",
    "test:release:policy": "node --test test/github-environment.test.cjs test/release-evidence.test.cjs test/sentinel-deployment-manifest.test.cjs",
    "verify:release:base-sepolia": "hardhat run scripts/verify-release-core.cjs --network baseSepolia",
    "verify:release:base": "hardhat run scripts/verify-release-core.cjs --network base",
    "verify:source:base-sepolia": "hardhat run deploy/verify-mainnet.ts --network baseSepolia",
    "verify:base": "hardhat run deploy/verify-mainnet.ts --network base",
    "patch:base": "node -e \"throw new Error('Automatic mainnet patching is disabled; use reviewed timelock governance')\"",
    "pipeline:base": "node -e \"throw new Error('One-command mainnet deployment is disabled; use the protected Base mainnet workflow')\"",
    "build:mobile": "cross-env MOBILE_BUILD=true next build && npx cap sync"
  },
  "dependencies": {
    "@apollo/client": "^4.1.9",
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@uniswap/v4-core": "^1.0.2",
    "fp-ts": "^2.16.11",
    "hono": "4.12.31",
    "io-ts": "^2.2.22",
    "next": "16.2.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@chainlink/contracts": "^1.2.0",
    "@chainlink/contracts-ccip": "^1.5.0",
    "@nomicfoundation/hardhat-ethers": "4.0.13",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.10",
    "@nomicfoundation/hardhat-mocha": "3.0.21",
    "@nomicfoundation/hardhat-verify": "3.0.21",
    "@openzeppelin/contracts": "5.6.1",
    "@types/chai": "^5.0.0",
    "@types/mocha": "^9.1.0",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "chai": "^5.2.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.18",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-security": "^2.1.1",
    "ethers": "6.17.0",
    "hardhat": "3.11.0",
    "mocha": "^11.7.6",
    "prettier": "^3.2.5",
    "solc": "0.8.28",
    "ts-node": "^10.0.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1",
    "@openzeppelin-3/contracts": "npm:@openzeppelin/contracts@^4.9.6",
    "@openzeppelin/contracts-4.7.3": "npm:@openzeppelin/contracts@^4.9.6",
    "@openzeppelin/contracts-4.8.3": "npm:@openzeppelin/contracts@^4.9.6",
    "cross-spawn": "^7.0.6",
    "semver": "^7.7.2",
    "qs": "^6.14.1",
    "yaml": "^2.8.3",
    "ejs": "^3.1.10",
    "tough-cookie": "^4.1.4",
    "elliptic": "^6.6.1",
    "form-data": "^4.0.0",
    "ws": "^8.20.2",
    "tmp": "^0.2.6",
    "undici": "^6.27.0",
    "axios": "^1.9.0",
    "cookie": "^0.7.2",
    "immutable": "^5.1.5",
    "js-yaml": "^4.1.1",
    "read-yaml-file": "^2.0.0",
    "glob": "^11.0.4",
    "eth-gas-reporter": "^0.2.27",
    "debug": "^4.3.7",
    "diff": "^5.2.1",
    "postcss": "8.5.18",
    "serialize-javascript": "^7.0.5",
    "uuid": "^14.0.0",
    "hardhat-gas-reporter": "^2.3.0",
    "ethers": "6.17.0",
    "@ethersproject/abi": "^5.8.0",
    "@ethersproject/abstract-provider": "^5.8.0",
    "@ethersproject/abstract-signer": "^5.8.0",
    "@ethersproject/contracts": "^5.8.0",
    "@ethersproject/hash": "^5.8.0",
    "@ethersproject/hdnode": "^5.8.0",
    "@ethersproject/json-wallets": "^5.8.0",
    "@ethersproject/providers": "^5.8.0",
    "@ethersproject/signing-key": "^5.8.0",
    "@ethersproject/transactions": "^5.8.0",
    "@ethersproject/wallet": "^5.8.0",
    "@ethersproject/wordlists": "^5.8.0",
    "sharp": "0.35.0"
  },
  "type": "module"
}
